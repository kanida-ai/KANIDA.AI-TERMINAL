# Credentials — never commit
config/.env
backend/.env
.env
*.env

# Databases — never commit production data
# data/db/*.db   ← temporarily included for Railway deployment (baked into image)
outputs/snapshots/*.db

# Published artifacts (R&D-DB-split) — BUILD OUTPUT, multi-MB, regenerable from
# the publishers in scripts/. Never commit the .db files (680 GiB git-bloat
# incident makes stray DB blobs dangerous). The tiny *.manifest.json IS tracked
# as a record of the expected schema / row-count / checksum.
data/artifacts/*.db
data/artifacts/*.db-wal
data/artifacts/*.db-shm
data/artifacts/*.building

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node / Frontend
frontend/node_modules/
frontend/.next/
frontend/.turbo/

# Outputs (generated, not source)
outputs/logs/
outputs/reports/
outputs/cache/

# Frontend env
frontend/.env.local
frontend/.env

# OS
.DS_Store
Thumbs.db

# Railway / deployment
*.log
outputs/fno_fetch.log
outputs/pipeline_*.log
outputs/fetch_*.log
outputs/refresh_*.log

# Runtime logs (regenerable — never source)
logs/

# Local archive — stale research artifacts, CSVs, old data kept for reference
# but NOT version-worthy (multi-MB data would bloat the repo). Organised on
# disk for tidiness; reconstructable from the pipeline. See docs/folder-structure.md.
archive/

# Claude Code session state + agent worktrees (tooling, not source)
.claude/
.railway/

# universe_engine: track the ENGINE CODE (engine/*.py, ~900KB) so the cloud CI
# build can ship it, but NEVER the multi-GB data warehouse or any DB/dataset.
# (See the Codex git-bloat incident — a stray data add wrote 680 GiB into .git.)
# These rules make even an accidental `git add universe_engine/` safe.
universe_engine/data/
universe_engine/**/*.db
universe_engine/**/*.db-wal
universe_engine/**/*.db-shm
universe_engine/**/*.sqlite
universe_engine/**/*.sqlite3
universe_engine/**/*.parquet
universe_engine/**/*.feather
universe_engine/**/*.csv
universe_engine/**/*.pkl
universe_engine/**/*.npy
universe_engine/**/*.npz
universe_engine/**/__pycache__/
# === Repo-bloat guard (added 2026-06-18 after a Codex `git add` runaway   ===
# === wrote 680 GiB of DB versions into .git and filled the disk).         ===
# SQLite sidecar files — never version
*.db-wal
*.db-shm
*.db-journal
# Multi-GB research databases — reconstructable from the pipeline; never commit
data/db/kanida_universe.db
data/db/_backups/
data/falcon.db
universe_engine/**/*.db
universe_engine/data/db/
