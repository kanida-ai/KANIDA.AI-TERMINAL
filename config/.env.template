# ============================================================
# KANIDA.AI Terminal — Quant Intelligence Engine
# Environment Configuration Template
# Copy this to .env and fill in your values. NEVER commit .env.
# This template file IS committed — keep it placeholder-only.
# ============================================================

# ── Claude AI ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── Zerodha Kite Connect (NSE + F&O) ───────────────────────
# Get from: kite.trade/account/apps
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=                          # Set daily by the auto-auth bot (leave empty)

# ── Zerodha Auto-Auth Bot (Layer 1, Playwright) ────────────
# Credentials for headless daily login. See config/AUTH_BOT_SETUP.md.
# Schedule is FIXED in auth_scheduler.py — 06:30/07:30/08:30/09:00 IST
# weekdays, with boot-catchup on restart. No enable flag — the
# scheduler always starts and no-ops cleanly when env vars are missing.
ZERODHA_USERNAME=your_kite_client_id        # e.g. AB1234
ZERODHA_PASSWORD=your_zerodha_password      # NO leading/trailing spaces
ZERODHA_TOTP_SECRET=your_base32_totp_seed   # the SEED, not the rotating 6-digit code.
                                            # Account MUST be on TOTP 2FA, not Mobile App Code.

# ── Polygon.io (US Equities + Options) ─────────────────────
# Get from: polygon.io/dashboard/api-keys
POLYGON_API_KEY=your_polygon_api_key

# ── Database ───────────────────────────────────────────────
# Path to the legacy quant DB (kite_tokens, falcon_auth_log lives in
# the power-user DB at data/db/kanida_universe.db).
# Relative paths are anchored to the project root regardless of CWD
# (see backend/services/kite_auth.py).
KANIDA_DB_PATH=data/db/kanida_quant.db

# ── Server ─────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Market Settings ────────────────────────────────────────
NSE_MARKET_OPEN_IST=09:15
NSE_MARKET_CLOSE_IST=15:30
US_MARKET_OPEN_ET=09:30
US_MARKET_CLOSE_ET=16:00

# ── Compliance Mode ────────────────────────────────────────
# SEBI_SAFE  → statistical framing only (use for India-facing product)
# GLOBAL     → direct signal language
COMPLIANCE_MODE=SEBI_SAFE

# ── Data Quality ───────────────────────────────────────────
# Reject any day where single-day move exceeds this threshold on low volume
DATA_QUALITY_MAX_MOVE_PCT=0.12
DATA_QUALITY_MIN_VOLUME_RATIO=0.30  # vs 30-day avg
