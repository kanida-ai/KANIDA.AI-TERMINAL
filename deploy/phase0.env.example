# ============================================================================
# deploy/phase0.env.example — template for docker-compose local parity
# ----------------------------------------------------------------------------
# Copy to deploy/phase0.env and fill in ONLY what you need for the boot test.
# The Phase-0 acceptance test (A2 preflight passes, GET / == 200) needs NO real
# secrets at all — the DB paths are injected by docker-compose.yml, and every
# gating flag below defaults to OFF/paper. Real broker secrets belong in AWS
# Secrets Manager for the cloud path (see deploy/SECRETS_MAP.md), NEVER in git.
#
#   *** deploy/phase0.env is git-ignored — do NOT commit a filled-in copy. ***
# ============================================================================

# ── Live-trading gates — KEEP OFF for the local boot test ────────────────────
# With these OFF the container is paper-safe: no real orders can be placed even
# if a stray broker token were present.
FALCON_AUTOTRADE_ENABLED=false
RUPEEZY_LIVE_CERTIFIED=false
FALCON_AUTOTRADE_EXECUTION_MODE=paper
AUTOTRADE_PORTAL_STRICT=true

# ── Auth / JWT (dummy values are fine for a boot test) ───────────────────────
# In prod these MUST be strong and come from Secrets Manager. Placeholders here
# only let the portal issue local tokens; they authenticate nothing real.
POWER_JWT_SECRET=local-dev-only-change-me
POWER_ADMIN_SECRET=local-dev-only-change-me
POWER_ADMIN_EMAIL=p.sundar.shyam@gmail.com
FALCON_OPERATOR_TOKEN=local-dev-only-change-me

# ── Vault key (Fernet) — leave BLANK locally ─────────────────────────────────
# Empty vault ⇒ broker-cred decryption + per-account egress simply return
# None/disabled (fail-open to direct/paper). Do NOT paste the real prod
# FALCON_VAULT_KEY here — losing/leaking it is a real-money incident.
FALCON_VAULT_KEY=

# ── Egress / proxy — leave BLANK locally (egress DIRECT) ─────────────────────
BROKER_PROXY_MAP=
BROKER_EGRESS_POOL=

# ── Web Push (VAPID) — blank locally; push just no-ops ───────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

# ── Third-party API keys — blank locally unless testing that surface ─────────
ANTHROPIC_API_KEY=
KITE_API_KEY=
KITE_API_SECRET=
POLYGON_API_KEY=

# ── Market hours (IST) — informational defaults ──────────────────────────────
NSE_MARKET_OPEN_IST=09:15
NSE_MARKET_CLOSE_IST=15:30
