# ─────────────────────────────────────────────────────────────────────────────
#  THE ONLY THING THAT CHANGES BETWEEN THE MOCK AND THE REAL ENGINE.
# ─────────────────────────────────────────────────────────────────────────────
# P0 mock   (cd backend && uvicorn pathfinder.mock_app:app --port 8010)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8010
#
# P1 engine (same paths, same schemas, same screens)
# EXPO_PUBLIC_API_BASE_URL=https://api.kanida.ai
#
# Leave it unset and the app infers the Metro host and port 8010, so scanning
# the QR code on a phone reaches the mock on your laptop with no configuration.
