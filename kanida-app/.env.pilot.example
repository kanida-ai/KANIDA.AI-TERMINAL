# Server only. Never prefix these values with EXPO_PUBLIC_.
PILOT_ENVIRONMENT=local
# Change to public to open registration; authentication and entitlements still apply.
PILOT_REGISTRATION_MODE=gated
PILOT_ORIGIN=http://127.0.0.1:8082
PILOT_ORIGINS=http://127.0.0.1:8082,http://localhost:8082
PILOT_OWNER_EMAIL=
# Local SQLite is created in var/. Use PostgreSQL on AWS.
PILOT_DATABASE_URL=
# Required on AWS: generate a Fernet key and store in Secrets Manager.
PILOT_ENCRYPTION_KEY=
PILOT_GOOGLE_CLIENT_ID=
PILOT_GOOGLE_CLIENT_SECRET=
PILOT_RAZORPAY_KEY_ID=
PILOT_RAZORPAY_KEY_SECRET=
PILOT_RAZORPAY_WEBHOOK_SECRET=
PILOT_RAZORPAY_PLAN_ID=
PILOT_KITE_API_KEY=
PILOT_KITE_API_SECRET=
PILOT_RESEARCH_URL=http://127.0.0.1:8765
PILOT_RESEARCH_DIRECTORY=
# This pilot must remain disabled until a separately approved activation.
PILOT_LIVE_ENABLED=false
PILOT_LIVE_ACTIVATION=
