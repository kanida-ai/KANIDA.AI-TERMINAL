  "question": "Does *who is selling* matter more than *how far it fell*?",
  "rationale": "The observer kept flagging pullbacks with near-identical price geometry and opposite outcomes. Price shape alone could not separate them, so the agent asked what else differed. Participation was the first candidate.",
  "rulebook": {
    "universe": "nifty500_pit",
    "direction": "long",
    "entry": "Close above the 50-session average AND 3 consecutive lower closes AND pullback volume < 0.75x the 20-session median AND breadth composite not in its lowest decile. Fill at the NEXT session open.",
    "invalidation": "A close below the low of the pullback's last session, or the 50-session average being lost. There is no price target — the idea is either still valid or it is not.",
    "exit": "Hard stop at -4% from entry; trail the 10-session low after +2%; hard horizon exit at 5 sessions.",
    "horizon_sessions": 5,
    "sizing": "Equal-weight, 2% of virtual capital per idea, maximum 8 concurrent.",
    "cost_convention": "costs_v3: brokerage+STT+exchange+GST+stamp, slippage 10bps, entry next open, exit at rule"
  },
